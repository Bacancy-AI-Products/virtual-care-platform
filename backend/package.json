{
    "name": "backend",
    "version": "1.0.0",
    "description": "",
    "main": "index.js",
    "scripts": {
        "build": "prisma generate && tsc",
        "start": "node dist/server.js",
        "dev": "nodemon --ext ts,json --ignore generated/ --ignore dist/ --exec \"npm run build && node dist/server.js\"",
        "seed": "npx ts-node prisma/seed.ts",
        "db:migrate": "prisma migrate dev",
        "db:migrate:deploy": "prisma migrate deploy",
        "db:migrate:status": "prisma migrate status",
        "lint": "eslint src",
        "lint:fix": "eslint src --fix",
        "format": "prettier --write ."
    },
    "prisma": {
        "seed": "ts-node prisma/seed.ts"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "type": "commonjs",
    "dependencies": {
        "@prisma/client": "^6.19.2",
        "@socket.io/redis-adapter": "^8.3.0",
        "axios": "^1.13.6",
        "bcrypt": "^6.0.0",
        "cors": "^2.8.6",
        "dotenv": "^17.3.1",
        "express": "^5.2.1",
        "jimp": "^1.6.0",
        "jsonwebtoken": "^9.0.3",
        "multer": "^2.1.1",
        "nodemailer": "^8.0.2",
        "pino": "^10.3.1",
        "pino-http": "^11.0.0",
        "redis": "^5.12.1",
        "socket.io": "^4.8.3",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@types/bcrypt": "^6.0.0",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/multer": "^2.1.0",
        "@types/node": "^25.5.0",
        "@types/nodemailer": "^7.0.11",
        "@types/pino-http": "^5.8.4",
        "eslint": "^9.17.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.5",
        "lint-staged": "^15.2.10",
        "nodemon": "^3.1.14",
        "pino-pretty": "^13.1.3",
        "prettier": "^3.8.1",
        "prisma": "^6.19.2",
        "ts-node": "^10.9.2",
        "typescript": "^5.0.0",
        "typescript-eslint": "^8.57.0"
    },
    "lint-staged": {
        "*.{ts,js}": [
            "prettier --write",
            "eslint --fix"
        ],
        "*.{json,md,yml,yaml}": [
            "prettier --write"
        ]
    }
}
