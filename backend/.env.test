# Test environment — loaded by test/setupEnv.ts before any code imports config.
# Override DATABASE_URL in CI via env vars; the value below targets the local docker compose Postgres.

NODE_ENV=test
PORT=4099

# Separate test database — keep schema name distinct from dev to avoid accidental writes.
DATABASE_URL=postgresql://telecareUser:anypassword@localhost:5432/telecare_test?schema=public

JWT_SECRET=test-jwt-secret-not-for-production
FRONTEND_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000

# Mailpit is fine to leave configured; tests mock the email module instead of sending.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=TeleCare Test <test@telecare.local>
