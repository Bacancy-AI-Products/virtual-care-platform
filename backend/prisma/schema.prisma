// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Enums ---
// Role for user auth and RBAC
enum Role {
  PATIENT
  DOCTOR
  ADMIN
}

// Appointment lifecycle and cancellation tracking
enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED_BY_PATIENT
  CANCELLED_BY_DOCTOR
  NO_SHOW
}

// File type for medical uploads (S3-ready)
enum FileType {
  REPORT
  IMAGE
  DOCUMENT
  OTHER
}

// Patient demographic (optional)
enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

// In-app notification types (prescription, appointment lifecycle)
enum NotificationType {
  PRESCRIPTION_CREATED
  APPOINTMENT_CONFIRMED
  APPOINTMENT_DECLINED
  APPOINTMENT_REQUESTED
  APPOINTMENT_CANCELLED
}

// Canonical list of medical specializations for doctors.
model Specialization {
  id   String @id
  name String @unique

  @@map("specializations")
}

// --- User (auth + base identity) ---
// Includes fields for email verification and password reset
model User {
  id                   String    @id @default(uuid())
  name                 String
  email                String    @unique
  passwordHash         String    @map("password_hash")
  role                 Role
  // Auth / verification
  emailVerified        Boolean?  @default(false) @map("email_verified")
  verificationToken    String?   @map("verification_token")
  passwordResetToken   String?   @map("password_reset_token")
  passwordResetExpires DateTime? @map("password_reset_expires")
  avatarFileId         String?   @map("avatar_file_id")
  /// Incremented when sessions are revoked (logout / password reset).
  tokenVersion         Int       @default(0) @map("token_version")
  // Audit
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  doctorProfile    DoctorProfile?
  patient          Patient?
  sentMessages     Message[]      @relation("SentMessages")
  receivedMessages Message[]      @relation("ReceivedMessages")
  uploadedFiles    File[]         @relation("UploadedFiles")
  ownedFiles       File[]         @relation("OwnedFiles")
  notifications    Notification[]

  @@map("users")
}

// --- Doctor profile (extends User) ---
model DoctorProfile {
  id                 String   @id @default(uuid())
  userId             String   @unique @map("user_id")
  specialization     String // Indexed for patient search
  experienceYears    Int?     @map("experience_years")
  bio                String?
  consultationFee    Decimal? @map("consultation_fee") @db.Decimal(10, 2)
  registrationNumber String?  @map("registration_number")
  degree             String?
  // Trust signals — credentials list, languages spoken
  credentials        Json?    // Array of { title, institution, year } — degrees, board certs, fellowships
  languages          String[] @default([]) // ISO language names — "English", "Spanish", etc.
  city               String?  // Location filter for discovery
  state              String?  // Location filter for discovery
  verified           Boolean  @default(false) @map("verified")
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  availability  DoctorAvailability[]
  appointments  Appointment[]
  prescriptions Prescription[]
  reviews       Review[]

  @@index([specialization])
  @@index([verified])
  @@index([city])
  @@index([state])
  @@map("doctor_profiles")
}

// --- Doctor availability (weekly time windows) ---
// Patients use this + existing appointments to see free slots
model DoctorAvailability {
  id           String   @id @default(uuid())
  doctorId     String   @map("doctor_id")
  weekday      Int // 0=Sunday, 6=Saturday
  startTime    String   @map("start_time") // HH:mm format (e.g. "09:00")
  endTime      String   @map("end_time") // HH:mm format (e.g. "17:00")
  slotDuration Int?     @default(30) @map("slot_duration") // minutes per slot
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  doctor DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId, weekday])
  @@map("doctor_availability")
}

// --- Patient (extends User) ---
model Patient {
  id                    String    @id @default(uuid())
  userId                String    @unique @map("user_id")
  dateOfBirth           DateTime? @map("date_of_birth") @db.Date
  gender                Gender?
  phone                 String?   @map("phone")
  bloodGroup            String?   @map("blood_group")
  height                Int?      @map("height") // cm
  weight                Decimal?  @map("weight") @db.Decimal(5, 2) // kg
  emergencyContactName  String?   @map("emergency_contact_name")
  emergencyContactPhone String?   @map("emergency_contact_phone")
  city                  String?   @map("city")
  state                 String?   @map("state")
  address               String?   @map("address")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments  Appointment[]
  prescriptions Prescription[]
  reviews       Review[]

  @@map("patients")
}

// --- Appointments ---
// Booking API must check for overlapping appointments (doctor + time range)
model Appointment {
  id               String            @id @default(uuid())
  patientId        String            @map("patient_id")
  doctorId         String            @map("doctor_id")
  scheduledAt      DateTime          @map("scheduled_at")
  durationMinutes  Int               @default(30) @map("duration_minutes")
  status           AppointmentStatus @default(PENDING)
  reason           String?
  declineReason    String?           @map("decline_reason")
  // Video session
  videoRoomId      String?           @map("video_room_id")
  meetingLink      String?           @map("meeting_link")
  sessionStartedAt DateTime?         @map("session_started_at")
  sessionEndedAt   DateTime?         @map("session_ended_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  patient       Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor        DoctorProfile  @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  messages      Message[]
  prescriptions Prescription[]
  files         File[]
  review        Review?

  @@index([doctorId, scheduledAt])
  @@index([patientId, scheduledAt])
  @@map("appointments")
}

// --- Reviews (one per completed appointment) ---
// Patients rate the doctor after a COMPLETED appointment. One review per appointment.
model Review {
  id            String   @id @default(uuid())
  doctorId      String   @map("doctor_id")
  patientId     String   @map("patient_id")
  appointmentId String   @unique @map("appointment_id") // one review per appointment
  rating        Int // 1–5 stars (validated at API layer)
  comment       String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  doctor      DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patient     Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointment Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([doctorId, createdAt(sort: Desc)])
  @@map("reviews")
}

// --- Messages ---
model Message {
  id            String   @id @default(uuid())
  senderId      String   @map("sender_id")
  receiverId    String   @map("receiver_id")
  appointmentId String?  @map("appointment_id")
  content       String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  sender      User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver    User         @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([appointmentId])
  @@index([senderId, receiverId, createdAt])
  @@map("messages")
}

// --- Prescriptions ---
model Prescription {
  id            String   @id @default(uuid())
  doctorId      String   @map("doctor_id")
  patientId     String   @map("patient_id")
  appointmentId String?  @map("appointment_id")
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  doctor      DoctorProfile      @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patient     Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointment Appointment?       @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  items       PrescriptionItem[]

  @@map("prescriptions")
}

// --- Prescription items (per-drug details) ---
model PrescriptionItem {
  id             String   @id @default(uuid())
  prescriptionId String   @map("prescription_id")
  drugName       String   @map("drug_name")
  dosage         String?
  frequency      String?
  duration       String?
  quantity       String?
  instructions   String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@map("prescription_items")
}

// --- Files (medical reports, profile images — blob stored in DB) ---
model File {
  id            String   @id @default(uuid())
  ownerId       String   @map("owner_id")
  appointmentId String?   @map("appointment_id")
  uploadedById  String   @map("uploaded_by_id")
  type          FileType
  storageKey    String?  @map("storage_key") // legacy: filesystem path; "db" when data in DB
  originalName  String   @map("original_name")
  mimeType      String   @map("mime_type")
  sizeBytes     BigInt   @map("size_bytes")
  data          Bytes?  @map("data") // optimized blob stored in DB
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  owner       User         @relation("OwnedFiles", fields: [ownerId], references: [id], onDelete: Cascade)
  uploadedBy  User         @relation("UploadedFiles", fields: [uploadedById], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@map("files")
}

// --- Audit log (HIPAA §164.312(b) — append-only, tamper-evident) ---
// NEVER update or delete rows from this table. Application code enforces this
// via the auditPrisma extended client in audit.service.ts.
// For production: also revoke UPDATE/DELETE on the access_logs table for the
// app DB user, or enable Postgres RLS as a defence-in-depth layer.
model AccessLog {
  id           String   @id @default(cuid())
  userId       String?  @map("user_id")
  actorRole    String?  @map("actor_role")
  action       String
  resourceType String?  @map("resource_type")
  resourceId   String?  @map("resource_id")
  ip           String?
  userAgent    String?  @map("user_agent")
  requestId    String?  @map("request_id")
  httpMethod   String?  @map("http_method")
  path         String?
  statusCode   Int?     @map("status_code")
  success      Boolean
  metadata     Json?
  prevHash     String?  @map("prev_hash")
  hash         String?
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@index([resourceType, resourceId])
  @@map("access_logs")
}

// --- Notifications (in-app bell + real-time via Socket.io) ---
model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  type      NotificationType
  title     String
  body      String?
  read      Boolean          @default(false)
  metadata  Json?            // e.g. { prescriptionId, appointmentId } for deep links
  createdAt DateTime        @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, read])
  @@map("notifications")
}
