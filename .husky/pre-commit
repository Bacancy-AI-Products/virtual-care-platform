#!/usr/bin/env bash
#
# Git pre-commit hook — runs lint-staged on staged frontend and backend files.
# Auto-formats with Prettier and auto-fixes with ESLint.
# Blocks commit if lint errors remain after auto-fix.
#
# To skip the hook for a single commit (rare, e.g. WIP):
#   git commit --no-verify
#

set -e

ROOT_DIR="$(git rev-parse --show-toplevel)"

# ── Secret scanning ───────────────────────────────────────────────────────────
# Blocks commits that introduce API keys, passwords, or tokens into any file.
cd "$ROOT_DIR"
if [ -d "node_modules/secretlint" ]; then
  if ! npx secretlint --secretlintrc .secretlintrc.json "**/.env*" "**/*.json" "**/*.ts" "**/*.tsx" "**/*.js" 2>/dev/null; then
    echo "🚨  secretlint detected secrets in staged files. Commit blocked."
    echo "    Remove the secret, use an env var, and try again."
    exit 1
  fi
else
  echo "⚠  secretlint not installed. Skipping secret scan."
  echo "   Run: npm install (in repo root)"
fi


# ── Frontend ──────────────────────────────────────────────────────────────────
cd "$ROOT_DIR/frontend"

if ! [ -d "node_modules/lint-staged" ]; then
  echo "⚠  lint-staged not installed in frontend. Skipping frontend checks."
  echo "   Run: cd frontend && npm install"
else
  npx lint-staged --concurrent false
fi

# ── Backend ───────────────────────────────────────────────────────────────────
cd "$ROOT_DIR/backend"

if ! [ -d "node_modules/lint-staged" ]; then
  echo "⚠  lint-staged not installed in backend. Skipping backend checks."
  echo "   Run: cd backend && npm install"
else
  npx lint-staged --concurrent false
fi
