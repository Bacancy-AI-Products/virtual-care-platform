# ─── Docker Compose ───────────────────────────────────────────────────────────
# Used by docker-compose.yml to create the Postgres container.
DB_NAME=telecare_db
DB_USER=telecare_user
DB_PASSWORD=change_me_strong_password_here
PORT=4001

# ─── Backend ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://<DB_USER>:<DB_PASSWORD>@<HOST>:<PORT>/<DB_NAME>?schema=public"
JWT_SECRET=replace_with_at_least_64_char_random_string
NODE_ENV=development
PORT=4001

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS="your_app_password_here"
MAIL_FROM="TeleCare <your_email@gmail.com>"

# ─── Video call provider ──────────────────────────────────────────────────────
# Daily.co (to be replaced — see docs/hipaa-plan.md, Out of scope: video BAA)
VIDEO_PROVIDER_API_KEY=replace_with_your_video_provider_api_key
VIDEO_PROVIDER_DOMAIN=your_subdomain.daily.co

# ─── App ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── Redis (Socket.io adapter) ────────────────────────────────────────────────
# Required for multi-instance production. Optional in single-instance dev.
REDIS_URL=redis://localhost:6379

# ─── Frontend (Next.js public vars) ───────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4001/api/v1

# ─── HIPAA Phase 1.1 — Audit Logging (implemented) ──────────────────────────
# 32-byte base64 key for HMAC-SHA256 tamper-evidence chain on audit logs.
# Generate: openssl rand -base64 32
# Required in production. Optional in dev (hashes skipped if absent).
LOG_HMAC_KEY=replace_with_32_byte_base64_encoded_random_string

# ─── HIPAA Phase 1.2 — Field-level AES-256-GCM Encryption (implemented) ─────
# 32-byte base64 master key used to encrypt PHI fields at rest.
# Generate: openssl rand -base64 32
# Required in production. In dev, omit to run without encryption (plaintext stored).
MASTER_KEY=replace_with_32_byte_base64_encoded_random_string
# Logical identifier for the current master key — embedded in every encrypted value.
# Increment (e.g. "v2") when rotating the key. Defaults to "v1".
KEY_ID=v1

# ─── HIPAA — Future phases (not yet implemented) ─────────────────────────────
# SECURITY_OFFICER_EMAIL=security@yourorg.com
# MFA_ISSUER=TeleCare
# RATE_LIMIT_REDIS_URL=redis://localhost:6379
# BACKUP_DEST_PATH=/var/backups/telecare
