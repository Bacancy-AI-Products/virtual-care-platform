# Claude Code tool configuration — contains allowed bash command patterns
# which include local test DB connection strings (not production credentials).
.claude/

# .env.example files are templates — they contain placeholder values only,
# never real credentials. Secretlint's pattern-matching would false-positive
# on connection string formats (e.g. postgresql://<USER>:<PASS>@host).
.env.example
**/.env.example

# backend/.env.test contains local-only test DB credentials used in CI only.
# The password is not used in any production environment.
backend/.env.test
